# Sentry - Frontend (must be prefixed with VITE_ to be exposed to browser)
VITE_SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
# Optional: Set traces sample rate (0.0 to 1.0). Default is 0.1 (10%)
# VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Sentry - Backend (serverless functions)
SENTRY_DSN=https://your-key@your-org.ingest.sentry.io/your-project-id
